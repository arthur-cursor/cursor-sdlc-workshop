<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pythagoras Practice</title>
  <style>
    :root {
      --bg: #0f1419;
      --card: #1a2332;
      --text: #e7eef7;
      --muted: #8b9cb3;
      --accent: #6ee7b7;
      --warn: #fca5a5;
    }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      min-height: 100vh;
      padding: 2rem 1rem;
      line-height: 1.5;
    }
    main {
      max-width: 36rem;
      margin: 0 auto;
      background: var(--card);
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0,0,0,.35);
    }
    h1 { font-size: 1.5rem; margin-top: 0; }
    .hint {
      font-size: 0.9rem;
      color: var(--muted);
      border-left: 3px solid var(--accent);
      padding-left: 0.75rem;
      margin: 1rem 0;
    }
    .formula {
      background: rgba(110, 231, 183, 0.08);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      margin: 1rem 0;
      font-family: ui-monospace, monospace;
    }
    .prompt { font-size: 1.15rem; margin: 1.25rem 0; }
    label { display: block; margin-bottom: 0.35rem; color: var(--muted); }
    input[type="text"] {
      width: 100%;
      max-width: 12rem;
      padding: 0.6rem 0.75rem;
      font-size: 1.1rem;
      border-radius: 8px;
      border: 1px solid #334155;
      background: var(--bg);
      color: var(--text);
    }
    button[type="submit"] {
      margin-top: 1rem;
      padding: 0.65rem 1.25rem;
      font-size: 1rem;
      border: none;
      border-radius: 8px;
      background: var(--accent);
      color: #0f1419;
      font-weight: 600;
      cursor: pointer;
    }
    button[type="submit"]:hover { filter: brightness(1.05); }
    .feedback {
      margin: 1rem 0;
      padding: 0.75rem 1rem;
      border-radius: 8px;
    }
    .feedback.ok { background: rgba(110, 231, 183, 0.15); color: var(--accent); }
    .feedback.no { background: rgba(252, 165, 165, 0.12); color: var(--warn); }
    .streak { color: var(--accent); font-weight: 600; margin: 0.5rem 0; }
    .links { margin-top: 1.5rem; font-size: 0.9rem; }
    .links a { color: #93c5fd; margin-right: 1rem; }
    .example { font-size: 0.85rem; color: var(--muted); margin-top: 0.5rem; }
  </style>
</head>
<body>
  <main>
    <h1>Pythagoras Practice</h1>
    <p class="hint">The hypotenuse is always the longest side, opposite the right angle. The other two sides are the legs. Use a² + b² = c² where c is the hypotenuse.</p>

    <% if (typeof showFormula !== 'undefined' && showFormula) { %>
      <div class="formula">a² + b² = c² &nbsp;(c = hypotenuse)</div>
      <p class="example">Example: legs 3 and 4 → 3² + 4² = 9 + 16 = 25, so c = √25 = 5.</p>
    <% } %>

    <% if (typeof streak !== 'undefined' && streak > 0) { %>
      <p class="streak">Streak: <%= streak %> in a row</p>
    <% } %>

    <% if (feedback && feedback.message) { %>
      <div class="feedback <%= feedback.ok ? 'ok' : 'no' %>" role="status">
        <%= feedback.message %>
      </div>
    <% } %>

    <p class="prompt"><%= prompt %></p>

    <form method="post" action="/check" autocomplete="off">
      <label for="answer">Your answer (length of the missing side)</label>
      <input id="answer" name="answer" type="text" inputmode="decimal" placeholder="e.g. 13" autofocus />
      <div>
        <button type="submit">Check answer</button>
      </div>
    </form>

    <div class="links">
      <a href="/?new=1">New question</a>
      <% if (showFormula) { %>
        <a href="/?help=0">Hide formula</a>
      <% } else { %>
        <a href="/?help=1">Show formula &amp; example</a>
      <% } %>
    </div>
  </main>
</body>
</html>
